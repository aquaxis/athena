          <mxGeometry x="20" y="100" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="ATHENA Core Agent&#10;(Producer level · instance #0)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
