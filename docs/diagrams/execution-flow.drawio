          <mxGeometry x="980" y="220" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="k1" value="" style="endArrow=block;html=1;fontSize=14;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k2" value="immediate child only&#10;(ATH-HIER-004)" style="endArrow=block;html=1;fontSize=14;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k3" value="" style="endArrow=block;html=1;fontSize=14;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k4" value="" style="endArrow=block;html=1;fontSize=14;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k5" value="" style="endArrow=block;html=1;fontSize=14;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="k6" value="through the Tool&#10;Manager's grant" style="endArrow=block;html=1;fontSize=14;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Logical hierarchy — expressed by message routing + permission containment, never process parentage (ATH-HIER-010). All Instances sit in parallel under the Runtime." style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1">
